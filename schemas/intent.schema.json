{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kongjie0325-art/daos-v4/schemas/intent.schema.json",
  "title": "DAOS Intent",
  "description": "A compiled intent that has passed policy check and is ready for simulation/execution",
  "type": "object",
  "required": [
    "id", "version", "timestamp", "actor", "action", "target_node",
    "target_network", "risk_level", "rollback_steps", "pre_snapshot"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^intent-[a-f0-9]{16}$",
      "description": "Unique intent identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^4\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "description": "LLM or agent that proposed this intent"
    },
    "action": {
      "type": "string",
      "enum": [
        "observe", "simulate", "execute", "modify_baseline",
        "modify_policy", "nftables_modify", "route_modify",
        "dns_modify", "store_evidence", "audit"
      ]
    },
    "target_node": {
      "type": "string",
      "description": "Hostname matching nodes.yaml"
    },
    "target_network": {
      "type": "string",
      "format": "ipv4-cidr"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "params": {
      "type": "object",
      "description": "Action-specific parameters"
    },
    "pre_snapshot": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string", "enum": ["nftables", "route_table", "dns_zone", "config_file"] },
        "path": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "rollback_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "command"],
        "properties": {
          "type": { "type": "string", "enum": ["restore_snapshot", "revert_config", "restart_service", "run_command"] },
          "command": { "type": "string" },
          "verify_command": { "type": "string" }
        }
      }
    },
    "verify_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "expected", "tolerance"],
        "properties": {
          "metric": { "type": "string" },
          "expected": { "type": ["number", "string"] },
          "tolerance": { "type": "number" }
        }
      }
    },
    "policy_results": {
      "type": "object",
      "properties": {
        "network_allowed": { "type": "boolean" },
        "execution_allowed": { "type": "boolean" },
        "trust_verified": { "type": "boolean" },
        "rate_limited": { "type": "boolean" }
      }
    },
    "simulation_id": {
      "type": "string",
      "description": "Link to simulation run if applicable"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_hash": { "type": "string" },
        "policy_version": { "type": "string" },
        "created_by": { "type": "string" }
      }
    }
  }
}
