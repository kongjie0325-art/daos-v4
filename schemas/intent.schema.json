{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://daos-v4.local/schemas/intent.schema.json",
  "title": "DAOS v4 Intent | \u53d8\u66f4\u610f\u56fe",
  "description": "Schema for an infrastructure change intent in DAOS v4.",
  "type": "object",
  "required": [
    "id",
    "action",
    "target_node",
    "target_network",
    "risk_level",
    "rollback_steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique intent identifier (UUID) | \u610f\u56fe\u552f\u4e00\u6807\u8bc6",
      "format": "uuid",
      "examples": [
        "b7f8a3e2-1c4d-5e6f-8a9b-0c1d2e3f4a5b"
      ]
    },
    "action": {
      "type": "string",
      "description": "Infrastructure operation to execute | \u8981\u6267\u884c\u7684\u57fa\u7840\u8bbe\u65bd\u64cd\u4f5c",
      "enum": [
        "observe",
        "simulate",
        "execute",
        "modify_baseline",
        "update_acl",
        "update_bgp_community",
        "update_nat_rule",
        "shutdown_interface",
        "update_vlan",
        "update_vrf"
      ],
      "examples": [
        "update_acl"
      ]
    },
    "target_node": {
      "type": "object",
      "description": "Target infrastructure node | \u76ee\u6807\u57fa\u7840\u8bbe\u65bd\u8282\u70b9",
      "required": [
        "id",
        "type",
        "trust_score"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Node identifier | \u8282\u70b9\u6807\u8bc6\u7b26"
        },
        "type": {
          "type": "string",
          "enum": [
            "node",
            "service",
            "network",
            "dns",
            "router",
            "switch",
            "firewall",
            "load_balancer"
          ],
          "description": "Node type | \u8282\u70b9\u7c7b\u578b"
        },
        "trust_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Historical trust score | \u5386\u53f2\u4fe1\u4efb\u5206\u6570"
        }
      }
    },
    "target_network": {
      "type": "string",
      "description": "Target network in CIDR notation (optional) | \u76ee\u6807\u7f51\u7edc CIDR \u683c\u5f0f\uff08\u53ef\u9009\uff09",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[1-2][0-9]|3[0-2])$",
      "examples": [
        "10.0.0.0/24"
      ]
    },
    "risk_level": {
      "type": "string",
      "description": "Assessed risk level | \u98ce\u9669\u8bc4\u4f30\u7b49\u7ea7",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "examples": [
        "medium"
      ]
    },
    "rollback_steps": {
      "type": "array",
      "description": "Ordered list of rollback instructions | \u6709\u5e8f\u7684\u56de\u6eda\u6307\u4ee4\u5217\u8868",
      "items": {
        "type": "object",
        "required": [
          "step",
          "command",
          "expected_outcome"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "description": "Step index | \u6b65\u9aa4\u5e8f\u53f7"
          },
          "command": {
            "type": "string",
            "description": "Rollback CLI command | \u56de\u6eda CLI \u547d\u4ee4"
          },
          "expected_outcome": {
            "type": "string",
            "description": "Expected success state | \u9884\u671f\u6210\u529f\u72b6\u6001"
          }
        }
      },
      "minItems": 1
    },
    "simulation_required": {
      "type": "boolean",
      "description": "Whether a simulation run is mandatory | \u662f\u5426\u5fc5\u987b\u6a21\u62df\u8fd0\u884c",
      "default": false
    },
    "change_window_override": {
      "type": "object",
      "description": "Optional override for the change window | \u53d8\u66f4\u7a97\u53e3\u7684\u53ef\u9009\u8986\u76d6",
      "properties": {
        "start_utc": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Override start time HH:MM UTC | \u8986\u76d6\u8d77\u59cb\u65f6\u95f4"
        },
        "end_utc": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Override end time HH:MM UTC | \u8986\u76d6\u7ed3\u675f\u65f6\u95f4"
        }
      }
    }
  }
}
