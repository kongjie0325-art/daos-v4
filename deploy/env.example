# DAOS v4 Environment Configuration / 环境配置
# Copy to .env and fill in values / 复制为 .env 并填入值

# --- Database / 数据库 ---
PG_PASSWORD=daos_secret

# --- Message Bus / 消息总线 ---
NATS_URL=nats://nats:4222

# --- Policy Engine / 策略引擎 ---
OPA_URL=http://opa:8181

# --- Monitoring / 可观测性 ---
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_PASSWORD=daos_admin

# --- Redis (optional cache) / 可选缓存 ---
REDIS_URL=redis://redis:6379

# --- Prometheus Targets (comma-separated) / Prometheus 目标 ---
NODE_TARGETS=localhost:9100
